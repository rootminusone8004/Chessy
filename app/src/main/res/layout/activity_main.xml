<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/customDarkBackground">

    <!-- Main Game Container -->
    <LinearLayout
        android:id="@+id/layoutGameContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/primaryOrange"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSideSelector"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/customSurfaceElevated"
                android:contentDescription="Select Player Side"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="White"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_chess_wn"
                app:iconSize="20dp"
                app:iconTint="@null" />

            <ImageButton
                android:id="@+id/btnOpeningsBook"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Opening Repertoire"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_book"
                app:tint="@color/primaryOrange" />

            <ImageButton
                android:id="@+id/btnManualLocateTop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Locate Engine"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@color/textSecondary" />

            <ImageButton
                android:id="@+id/btnTermuxSetup"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_termux_setup"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_terminal"
                app:tint="@color/primaryOrange" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/textSecondary" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Top Player (Opponent / Engine) Card -->
                <LinearLayout
                    android:id="@+id/layoutTopPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_rounded_card"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivOpponentIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_icon"
                        android:contentDescription="Opponent"
                        android:padding="4dp"
                        android:src="@drawable/ic_chess_bn" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOpponentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stockfish (Engine)"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEngineStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/termux_status_connected"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbEngineThinking"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/primaryOrange"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Current Opening Banner -->
                <LinearLayout
                    android:id="@+id/layoutOpeningBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_rounded_card"
                    android:backgroundTint="@color/customSurfaceElevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/primaryOrange" />

                    <TextView
                        android:id="@+id/tvCurrentOpeningEco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/customSurfaceDarker"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="C33"
                        android:textColor="@color/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentOpeningName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="King's Gambit (Bishop's Gambit)"
                        android:textColor="@color/primaryOrangeLight"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENGINE BOOK"
                        android:textColor="@color/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Chess Board -->
                <com.mhrahmankwoshik.chessy.ui.ChessBoardView
                    android:id="@+id/chessBoardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <!-- Bottom Player (User) Card -->
                <LinearLayout
                    android:id="@+id/layoutBottomPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_rounded_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivPlayerIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_icon"
                        android:contentDescription="Player"
                        android:padding="4dp"
                        android:src="@drawable/ic_chess_wn" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPlayerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You (Player)"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGameTurnStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_your_turn"
                            android:textColor="@color/primaryOrange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Move History -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMoveHistory"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_move_history" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/customCard"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_undo"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnFlipBoard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_flip_board"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_swap"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnResign"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_resign"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_flag"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnSharePgn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_copy_pgn"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewGame"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/primaryOrange"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/action_new_game"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_new_game"
                app:iconPadding="4dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- Prerequisite & Engine Connection Screen -->
    <ScrollView
        android:id="@+id/layoutEngineMissingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/customDarkBackground"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivMissingIcon"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="Terminal Required"
                android:padding="14dp"
                android:src="@drawable/ic_terminal"
                app:tint="@color/primaryOrange" />

            <TextView
                android:id="@+id/tvMissingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Connect Chessy to Termux"
                android:textColor="@color/primaryOrange"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMissingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="To send chess moves directly to Stockfish, run the 1-line command in Termux:"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <!-- Method 1: Direct Socket Card (Recommended) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/customSurfaceDarker"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stockfish Localhost Socket Bridge"
                    android:textColor="@color/primaryOrangeLight"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Keep Termux running in the background and execute:"
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDirectSocketCommand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="socat TCP-LISTEN:2222,reuseaddr,fork EXEC:stockfish"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <ImageButton
                        android:id="@+id/btnCopySocketCommand"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy Socket Command"
                        android:src="@drawable/ic_content_copy"
                        app:tint="@color/primaryOrange" />
                </LinearLayout>
            </LinearLayout>

            <!-- First-Time Setup Card (Separated) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/customSurfaceDarker"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First-time setup (run once in Termux):"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDirectInstallCommand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="pkg install -y stockfish socat"
                        android:textColor="@color/primaryOrangeLight"
                        android:textSize="11sp" />

                    <ImageButton
                        android:id="@+id/btnCopyInstallCommandOverlay"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy Install Command"
                        android:src="@drawable/ic_content_copy"
                        app:tint="@color/textSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Diagnostic Error Log -->
            <TextView
                android:id="@+id/tvOverlayErrorLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/black"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="@color/status_red"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Action Buttons Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallOrOpenTermux"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Open Termux"
                    android:textColor="@color/primaryOrange"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primaryOrange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerifyEngine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primaryOrange"
                    android:text="Connect &amp; Play"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Action Buttons Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocateManually"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Locate / Storage"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProceedAnyway"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="I've Installed It"
                    android:textColor="@color/primaryOrangeLight"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
